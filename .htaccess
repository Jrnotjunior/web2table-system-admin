# Web2Table System Admin — Hostinger Apache configuration
Options -Indexes

# SPA fallback: let Vite/React handle client-side routes while serving real files normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Cache fingerprinted Vite assets; keep the entry HTML fresh after deployments.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|mjs|css|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Prevent direct access to environment/configuration files if any are accidentally uploaded.
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
<FilesMatch "^(?:\.env(?:\..*)?|package(?:-lock)?\.json|tsconfig(?:\..*)?\.json)$">
  Require all denied
</FilesMatch>
