# Web2Table System Admin — Hostinger Apache configuration
Options -Indexes

# Let React handle client-side routes while serving existing files normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Cache built assets, but always fetch fresh entry HTML after a deployment.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|mjs|css|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Prevent direct requests for dotfiles and common build/config files.
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
<FilesMatch "^(?:\.env(?:\..*)?|package(?:-lock)?\.json|tsconfig(?:\..*)?\.json)$">
  Require all denied
</FilesMatch>
